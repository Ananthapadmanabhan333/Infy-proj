# SA API — environment variables (reference template; never commit real values).
# Production (Render) sets these in the service's Environment settings. Full reference: docs/DEPLOYMENT.md.
# Local development needs none of them: run with SPRING_PROFILES_ACTIVE=local, or `mvn spring-boot:test-run
# -Dspring-boot.run.main-class=com.nexus360.LocalDevApplication` for an embedded PostgreSQL.

# --- Required -----------------------------------------------------------------
# JDBC URL, or a provider URL such as Neon's postgresql://user:pass@host/db?sslmode=require (credentials are extracted).
DATABASE_URL=
# Only needed when DATABASE_URL is a JDBC URL without credentials.
DATABASE_USER=
DATABASE_PASSWORD=
# HS256 signing key, at least 32 characters (openssl rand -base64 48).
JWT_SECRET=
# Comma-separated browser origins allowed to call the API with credentials, e.g. https://nexus360.vercel.app
FRONTEND_ORIGIN=

# --- Server & database --------------------------------------------------------
PORT=8080
DB_POOL_MAX=8
DB_POOL_MIN_IDLE=1
# Proxies whose X-Forwarded-For entries are trusted: Tomcat default = private and loopback ranges. Override with
# SERVER_TOMCAT_REMOTEIP_INTERNALPROXIES=<regex>

# --- Sessions -----------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Sign-ins without "remember me" get a browser-session cookie and end this many hours after sign-in (1-72).
BROWSER_SESSION_HOURS=12
# Refresh cookie flags. Keep Secure=true on HTTPS. SameSite=None is required only when the browser calls the API
# cross-site (VITE_API_URL pointing at another domain); Lax is enough behind the Vercel /api proxy.
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# --- Rate limiting & Redis ----------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_INBOUND_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=30
# Shares rate-limit counters across instances. Without Redis an in-memory limiter is used (fine for one instance).
REDIS_ENABLED=false
REDIS_URL=

# --- Accounts & demo data -----------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
APP_DEMO_SEED=false
APP_DEMO_PASSWORD=
APP_DEMO_SHOW_PASSWORD=false

# --- SA AI -----------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=8000
AI_EFFORT=low

# --- E-mail (optional) --------------------------------------------------------
# Without MAIL_HOST every e-mail is recorded in the outbox as SKIPPED and nothing claims delivery.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address; defaults to MAIL_USERNAME when that is an address.
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_OUTBOX_ENABLED=true
MAIL_POLL_INTERVAL_MS=30000
MAIL_MAX_ATTEMPTS=5
# Absolute web-app URL for links in e-mails (invitations, password resets, notifications, status page),
# e.g. https://sa.example.com. Defaults to the first FRONTEND_ORIGIN.
APP_PUBLIC_URL=

# --- Engines ------------------------------------------------------------------
SLA_SCHEDULER_ENABLED=true
SLA_EVALUATION_INTERVAL_MS=60000
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_SCHEDULE_POLL_INTERVAL_MS=60000
REPORT_SCHEDULER_ENABLED=true
REPORT_POLL_INTERVAL_MS=60000
INTEGRATION_ENCRYPTION_KEY=
INTEGRATIONS_ALLOW_PRIVATE_TARGETS=false
# Release 4: set true only on evaluation/demo deployments to allow switching Simulation Mode on in Settings.
SIMULATION_ALLOWED=false
AGENT_RUNS_PER_USER_PER_HOUR=20

# --- API documentation --------------------------------------------------------
SWAGGER_ENABLED=true
