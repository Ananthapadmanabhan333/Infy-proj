# SA — environment for `docker compose up` (copy to .env; .env is git-ignored).
# Every variable is documented in DEPLOYMENT.md (section 9). Never commit real values.

# --- Required -----------------------------------------------------------------
# Password for the compose PostgreSQL container (any strong value).
POSTGRES_PASSWORD=
# HS256 signing key for access tokens, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Demo data ----------------------------------------------------------------
# Seeds the demo organisation (28 users, 139 incidents, all flagged DEMO). Turn off for real use.
APP_DEMO_SEED=true
# Password shared by all seeded demo users (min 10 chars, letters and digits). Required when APP_DEMO_SEED=true.
APP_DEMO_PASSWORD=
# Show the demo password on the login screen (convenient for demos; keep false anywhere public).
APP_DEMO_SHOW_PASSWORD=false

# --- First administrator (optional) -------------------------------------------
# Created at startup when no administrator exists; must change the password on first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- SA AI (optional) ------------------------------------------------------
# anthropic | none. Without a key every AI feature uses the labelled deterministic fallback engine.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Integrations (optional) --------------------------------------------------
# AES-256 key for stored webhook secrets: 32 random bytes, base64. Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# --- E-mail (optional) --------------------------------------------------------
# Without MAIL_HOST nothing is sent: messages are recorded as SKIPPED and the UI says e-mail is not configured.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
# Absolute base URL used in e-mailed links, e.g. http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
